# Hindsight local configuration example.
# Copy to .env and fill in your own PostgreSQL connection string.
HINDSIGHT_API_LLM_PROVIDER=ollama
HINDSIGHT_API_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:11434/v1
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
HINDSIGHT_API_LLM_OLLAMA_NUM_CTX=16384
HINDSIGHT_API_EMBEDDINGS_PROVIDER=local
HINDSIGHT_API_EMBEDDINGS_LOCAL_MODEL=D:\models\bge-small-zh-v1.5
HINDSIGHT_API_EMBEDDINGS_LOCAL_FORCE_CPU=true
HINDSIGHT_API_ENABLE_OBSERVATIONS=false
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_LOG_LEVEL=INFO
HINDSIGHT_API_WORKER_ID=hindsight-local
HINDSIGHT_API_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/hindsight
# BookCompiler local configuration example.
# Copy to .env and fill in your own API keys. Never commit .env.

BOOKCOMPILER_EMBED_BACKEND=neural
BOOKCOMPILER_EMBED_MODEL=D:\models\bge-small-zh-v1.5
BOOKCOMPILER_EMBED_BATCH=32
BOOKCOMPILER_EMBED_DEVICE=auto
BOOKCOMPILER_RERANK=0
BOOKCOMPILER_RERANK_MODEL=D:\models\bge-reranker-base
BOOKCOMPILER_RERANK_BATCH=8

HINDSIGHT_ENABLED=1
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_BANK_ID=bookcompiler
HINDSIGHT_TIMEOUT=20

BOOKCOMPILER_OBSIDIAN_VAULT=C:\Users\mybea\Documents\Obsidian Vault
BOOKCOMPILER_OBSIDIAN_SUBDIR=BookCompiler
BOOKCOMPILER_OBSIDIAN_INBOX=BookCompiler Inbox
HINDSIGHT_OBSIDIAN_SUBDIR=Hindsight
HINDSIGHT_OBSIDIAN_INBOX=Hindsight Inbox

BOOKCOMPILER_HERMES_HOME=D:\hermes agent
BOOKCOMPILER_HINDSIGHT_HOME=D:\hindsight

BOOKCOMPILER_READER_PROVIDER=openai-compatible
BOOKCOMPILER_READER_MODEL=mimo-v2.6-flash
BOOKCOMPILER_READER_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
BOOKCOMPILER_READER_API_KEY=

BOOKCOMPILER_JUDGE_PROVIDER=openai-compatible
BOOKCOMPILER_JUDGE_MODEL=mimo-v2.6-flash
BOOKCOMPILER_JUDGE_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
BOOKCOMPILER_JUDGE_API_KEY=

# Provider keys used as fallbacks:
# XIAOMI_API_KEY=
# MIMO_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
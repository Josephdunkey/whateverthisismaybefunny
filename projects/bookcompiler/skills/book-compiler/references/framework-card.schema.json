{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameworkCard",
  "type": "object",
  "required": ["framework_id", "book_id", "name", "one_liner", "lenses", "applicable_when", "inputs", "steps", "outputs", "failure_modes", "counterexamples", "citations", "related_frameworks", "confidence", "status"],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["book_id", "quote", "chunk_id", "chapter", "page"],
      "properties": {
        "book_id": {"type": "string"},
        "quote": {"type": "string", "minLength": 12},
        "chunk_id": {"type": "string"},
        "chapter": {"type": "string"},
        "page": {"type": ["integer", "null"]}
      }
    }
  },
  "properties": {
    "framework_id": {"type": "string"},
    "book_id": {"type": "string"},
    "name": {"type": "string"},
    "one_liner": {"type": "string", "minLength": 20},
    "lenses": {"type": "array", "items": {"type": "string", "enum": ["economics", "politics", "law", "general"]}},
    "applicable_when": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "failure_modes": {"type": "array", "items": {"type": "string"}},
    "counterexamples": {"type": "array", "items": {"type": "string"}},
    "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "related_frameworks": {"type": "array", "items": {"type": "string"}},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
    "status": {"type": "string", "enum": ["draft", "verified", "heuristic"]}
  }
}